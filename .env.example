PORT=3000

# From https://platform.claude.com. Without it the server starts, but every match answers 503.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Limits, counted in memory
REQUESTS_PER_MINUTE=30
REQUESTS_PER_DAY=100
CLAUDE_CALLS_PER_DAY=1000

# How many proxies in front of the server to trust for the caller's IP
TRUST_PROXY_HOPS=0
